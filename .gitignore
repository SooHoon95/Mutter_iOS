# Xcode
#
# gitignore contributors: remember to update Global/Xcode.gitignore, Objective-C.gitignore & Swift.gitignore

## User settings
xcuserdata/

## Tooling runtime state (oh-my-claudecode 등 — 커밋 대상 아님)
state/

## compatibility with Xcode 8 and earlier (ignoring not required starting Xcode 9)
*.xcscmblueprint
*.xccheckout
gitPAT.txt

## compatibility with Xcode 3 and earlier (ignoring not required starting Xcode 4)
build/
**/DerivedData/
*.moved-aside
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
**/.DS_Store

## Obj-C/Swift specific
*.hmap

## App packaging
*.ipa
*.dSYM.zip
*.dSYM

## Playgrounds
timeline.xctimeline
playground.xcworkspace

# Swift Package Manager
#
# Add this line if you want to avoid checking in source code from Swift Package Manager dependencies.

Packages/
Package.pins
Package.resolved
Tuist/Package.resolved
*.xcodeproj


# Xcode automatically generates this directory with a .xcworkspacedata file and xcuserdata
# hence it is not needed unless you have added a package configuration file to your project
.swiftpm

.build/

fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

**/*.pbxproj
**/*.xcscheme
**/*.xcworkspacedata
iOSInjectionProject/

Sensitive.xcconfig*
fastlane/portal.json
fastlane/.env.default

# Firebase 설정 — 클라이언트 키지만 GitHub secret scanning에 걸리므로 커밋 안 함. 로컬/CI에서 각자 주입.
GoogleService-Info.plist

# 코드 서명 / App Store Connect API 키 — 절대 커밋 금지(유출 시 배포 권한 탈취).
*.p8
*.p12
*.cer
*.mobileprovision
fastlane/*.p8


Gemfile.lock
Tuist/.DS_Store
**/.DS_Store
Projects/**/Derived

# Claude 하네스 — 표준은 커밋(CLAUDE.md · .claude/skills · .claude/commands), 런타임/로컬만 무시
.claude/settings.local.json
agent_docs/

# OMC / Ralph 런타임 상태 (무시)
.omc/
.omx/

# 마케팅 산출물 — 프롬프트·브리프·카피는 커밋, 렌더·의존성은 무시
marketing/**/node_modules/
marketing/**/renders/
marketing/**/*.mp4
marketing/**/*.mov

# 마케팅 루프 — 로컬 로그와 비밀값은 무시, 데이터·리포트·큐는 커밋
marketing/data/logs/
marketing/LOOP_DISABLED
.env.marketing
__pycache__/
# 서브에이전트 memory: project 런타임 상태 — 커밋 안 함
.claude/agent-memory/

# Claude↔Codex 핑퐁 스레드 상태(scripts/ai)
.ai-pingpong/
