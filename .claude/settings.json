{
  "enabledPlugins": {
    "marketing-skills@marketingskills": true,
    "aso-skills@aso-skills": true
  },
  "extraKnownMarketplaces": {
    "marketingskills": {
      "source": {
        "source": "github",
        "repo": "coreyhaines31/marketingskills"
      }
    },
    "aso-skills": {
      "source": {
        "source": "github",
        "repo": "eronred/aso-skills"
      }
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/route-marketing-to-codex.sh"
          }
        ]
      }
    ]
  }
}
